# Provide these values from the Database/Infrastructure Team
DATABASE_URL=postgresql://production_user:secure_password@database.internal.network:5432/civicpulse
REDIS_URL=redis://redis.internal.network:6379/0

# Provide these values from the Storage Team
MINIO_ENDPOINT=s3.amazonaws.com
MINIO_ACCESS_KEY=your_aws_access_key
MINIO_SECRET_KEY=your_aws_secret_key
MINIO_BUCKET=civicpulse-production-media

# Provide this from the Frontend Team
FRONTEND_URL=https://app.civicpulse.com

# Backend specific settings
JWT_SECRET=super_secure_production_secret
DEMO_MODE=False
LOG_LEVEL=WARNING
